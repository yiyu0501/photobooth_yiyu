<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Utopia Photo Booth</title>
  <style>
    :root{--bg:#f5f7fb;--panel:#fff;--text:#111827;--muted:#6b7280;--line:#e5e7eb;--ok:#047857;--danger:#b91c1c;--radius:24px;}
    *{box-sizing:border-box} body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans TC","PingFang TC","Microsoft JhengHei",Arial,sans-serif;background:var(--bg);color:var(--text)}
    button,input,select{font:inherit}.app{width:min(1280px,100%);margin:0 auto;padding:22px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:18px}.brand{display:flex;align-items:center;gap:12px}.logo{width:42px;height:42px;border-radius:14px;background:#111827;color:#fff;display:grid;place-items:center;font-weight:900}.brand h1{font-size:24px;margin:0}.brand p{margin:2px 0 0;color:var(--muted);font-size:14px}.topActions{display:flex;gap:10px;flex-wrap:wrap}.grid{display:grid;grid-template-columns:minmax(360px,1fr) minmax(360px,460px);gap:18px;align-items:start}.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:18px;box-shadow:0 10px 30px rgba(15,23,42,.06)}.panelTitle{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px}.panelTitle h2{margin:0;font-size:22px}.panelTitle p{margin:4px 0 0;color:var(--muted);line-height:1.5;font-size:14px}.btn{border:0;border-radius:999px;padding:10px 16px;background:#111827;color:#fff;cursor:pointer;font-weight:800;white-space:nowrap}.btn:hover{transform:translateY(-1px)}.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}.btn.secondary{background:#eef2f7;color:#111827;border:1px solid #d8dee9}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:12px 0}.field{display:grid;gap:6px;flex:1 1 190px}.field label{font-size:13px;color:var(--muted);font-weight:800}select,input[type=password]{width:100%;border:1px solid var(--line);border-radius:14px;background:#fff;color:#111827;padding:10px 12px;outline:none}input[type=file]{width:100%;border:1px dashed #cbd5e1;border-radius:18px;padding:14px;background:#f8fafc;cursor:pointer}.frames{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin:10px 0 14px}.frameCard{position:relative;border:2px solid transparent;background:#f8fafc;border-radius:18px;padding:8px;cursor:pointer;text-align:left;overflow:hidden}.frameCard.active{border-color:#111827;background:#fff;box-shadow:0 8px 22px rgba(15,23,42,.12)}.frameCard img{width:100%;aspect-ratio:2/3;object-fit:cover;border-radius:12px;background:#111827;display:block}.frameCard span{display:block;margin-top:7px;font-size:12px;color:#334155;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.videoWrap{position:relative;overflow:hidden;border-radius:22px;border:1px solid #dbe2ea;background:#0f172a;aspect-ratio:4/3;display:grid;place-items:center}video{width:100%;height:100%;object-fit:cover;background:#0f172a;display:block}.videoWrap.mirror video{transform:scaleX(-1)}.countdown{position:absolute;inset:0;display:none;place-items:center;background:rgba(15,23,42,.42);color:#fff;font-size:96px;font-weight:900;text-shadow:0 10px 30px rgba(0,0,0,.45);z-index:4}.countdown.show{display:grid}.shotList{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.shot{aspect-ratio:4/3;border-radius:16px;overflow:hidden;background:#e5e7eb;display:grid;place-items:center;color:#64748b;font-weight:900;border:1px solid #dbe2ea}.shot img{width:100%;height:100%;object-fit:cover;display:block}.status{min-height:24px;margin:10px 0 0;color:var(--muted);font-size:14px;line-height:1.5}.status.ok{color:var(--ok);font-weight:800}.status.bad{color:var(--danger);font-weight:800}.previewShell{position:sticky;top:18px}.previewHeader{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.previewHeader h2{margin:0;font-size:24px}.previewHeader span{color:var(--muted);font-weight:900;font-size:18px}.previewBox{padding:14px;border-radius:28px;background:#0f172a;box-shadow:0 12px 28px rgba(15,23,42,.16)}#previewCanvas{width:100%;aspect-ratio:2/3;display:block;border-radius:6px;background:#111827}.downloadBar{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}.staffPanel{display:none;margin-top:14px;border-top:1px solid var(--line);padding-top:14px}.staffPanel.show{display:block}.smallNote,.hint{font-size:13px;color:var(--muted);line-height:1.5;margin-top:8px}.handover{position:fixed;inset:0;z-index:50;background:#111827;color:#fff;display:none;align-items:center;justify-content:center;padding:24px;text-align:center;cursor:pointer}.handover.show{display:flex}.handoverCard{width:min(560px,100%)}.handover h2{margin:0 0 12px;font-size:36px}.handover p{margin:0;color:#cbd5e1;font-size:18px;line-height:1.7}@media(max-width:880px){.app{padding:14px}.grid{grid-template-columns:1fr}.previewShell{position:static}.topbar{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
  <div class="app">
    <header class="topbar">
      <div class="brand"><div class="logo">益</div><div><h1>Utopia Photo Booth</h1><p>益智與設計思考社｜三張拍貼條版型</p></div></div>
      <div class="topActions"><button class="btn" id="startCameraBtn" type="button">啟動相機</button><button class="btn secondary" id="staffModeBtn" type="button">工作人員模式</button></div>
    </header>
    <main class="grid">
      <section class="panel">
        <div class="panelTitle"><div><h2>三張拍貼條版型</h2><p>固定直式 4 × 6 比例輸出。先選相框，再拍照或上傳照片。</p></div></div>
        <div class="field"><label>相框選擇</label><div class="frames" id="framesGrid"></div></div>
        <div class="panelTitle" style="margin-top:18px"><div><h2>拍照介面</h2><p>每次固定拍 3 張。右側會即時顯示照片進框後的位置。</p></div></div>
        <div class="row"><div class="field"><label for="cameraSelect">鏡頭選擇</label><select id="cameraSelect"><option value="">啟動相機後載入可用鏡頭</option></select></div><div class="field"><label for="shotModeSelect">拍攝視角</label><select id="shotModeSelect"><option value="normal">標準 1x</option><option value="mirror">自拍鏡像</option></select></div></div>
        <div class="videoWrap" id="videoWrap"><video id="video" autoplay playsinline muted></video><div class="countdown" id="countdown">5</div></div>
        <div class="row"><button class="btn" id="captureBtn" type="button" disabled>開始拍 3 張</button><button class="btn secondary" id="clearShotsBtn" type="button">重新拍攝</button></div>
        <div class="row"><div class="field"><label for="photoUpload">上傳照片</label><input id="photoUpload" type="file" accept="image/*" multiple></div></div>
        <div class="shotList" id="shotList"><div class="shot">1</div><div class="shot">2</div><div class="shot">3</div></div>
        <div class="status" id="status">尚未拍攝，請先啟動相機，或直接上傳 3 張照片測試。</div>
        <div class="staffPanel" id="staffPanel">
          <div class="panelTitle"><div><h2>工作人員模式</h2><p>這版順序是：貓、狗、電影節、畢業、01、02、03。</p></div></div>
          <div class="row"><div class="field"><label for="staffPassword">工作人員密碼（可留空）</label><input id="staffPassword" type="password" placeholder="現場需要再自行設定即可"></div></div>
          <div class="row"><div class="field"><label for="frameUpload">上傳相框 PNG</label><input id="frameUpload" type="file" accept="image/png,image/*"><div class="smallNote">自訂相框會先自動偵測透明照片窗，偵測不到時會套用標準三格位置。</div></div></div>
          <div class="row"><button class="btn secondary" id="resetFramesBtn" type="button">清空自訂相框，恢復預設</button><label class="hint"><input id="showSlotGuide" type="checkbox"> 顯示照片窗輔助線</label></div>
        </div>
      </section>
      <aside class="previewShell">
        <div class="previewHeader"><h2>即時相框預覽</h2><span>每拍一張就會先進框</span></div>
        <div class="previewBox"><canvas id="previewCanvas" width="1200" height="1800"></canvas></div>
        <div class="downloadBar"><button class="btn" id="downloadBtn" type="button" disabled>下載成品</button><button class="btn secondary" id="renderBtn" type="button">更新預覽</button></div>
        <p class="smallNote">若 GitHub Pages 改完還是舊畫面，請用無痕視窗或按 Command + Shift + R 強制重新整理。</p>
      </aside>
    </main>
  </div>
  <div class="handover" id="handover"><div class="handoverCard"><h2>現在請工作人員進場</h2><p>拍攝已完成。請參加者先離開拍照區，交由工作人員進行下載與輸出處理。<br>點擊任意位置繼續。</p></div></div>
  <script>
    const EXPORT_W = 1200;
    const EXPORT_H = 1800;
    const PHOTO_COUNT = 3;
    const COUNTDOWN_SECONDS = 5;

    // 目前 images 資料夾檔案順序：貓、狗、電影節、畢業、01、02、03。
    // 注意：檔名大小寫要跟 GitHub 一模一樣。
    // 若畢業圖還沒上傳，先把 graduation.png 放進 images 資料夾；若檔名不同，改下面 dataUrl 那一行。
    const PRESET_FRAMES = [
      {
        id: 'cat',
        name: '貓',
        dataUrl: './images/xiaomao.png',
        baseWidth: 667,
        baseHeight: 1000,
        slots: [
          { x: 176, y: 54,  w: 347, h: 198 },
          { x: 176, y: 276, w: 347, h: 198 },
          { x: 176, y: 498, w: 347, h: 199 }
        ]
      },
      {
        id: 'dog',
        name: '狗',
        dataUrl: './images/xiaogou.png',
        baseWidth: 667,
        baseHeight: 1000,
        slots: [
          { x: 177, y: 58,  w: 344, h: 194 },
          { x: 177, y: 279, w: 344, h: 197 },
          { x: 177, y: 504, w: 344, h: 193 }
        ]
      },
      {
        id: 'moviefest',
        name: '電影節',
        dataUrl: './images/moviefest.png',
        baseWidth: 667,
        baseHeight: 1000,
        slots: [
          { x: 170, y: 97,  w: 330, h: 212 },
          { x: 170, y: 322, w: 330, h: 215 },
          { x: 170, y: 550, w: 330, h: 216 }
        ]
      },
      {
        id: 'graduation',
        name: '畢業',
        dataUrl: './images/graduation.png',
        baseWidth: 667,
        baseHeight: 1000,
        slots: [
          { x: 176, y: 54,  w: 347, h: 198 },
          { x: 176, y: 276, w: 347, h: 198 },
          { x: 176, y: 498, w: 347, h: 199 }
        ]
      },
      {
        id: 'frame01',
        name: '01',
        dataUrl: './images/01.png.png',
        baseWidth: 667,
        baseHeight: 1000,
        slots: [
          { x: 160, y: 50,  w: 363, h: 256 },
          { x: 160, y: 317, w: 363, h: 244 },
          { x: 160, y: 572, w: 363, h: 219 }
        ]
      },
      {
        id: 'frame02',
        name: '02',
        dataUrl: './images/02.png.png',
        baseWidth: 667,
        baseHeight: 1000,
        slots: [
          { x: 170, y: 97,  w: 330, h: 212 },
          { x: 170, y: 322, w: 330, h: 215 },
          { x: 170, y: 550, w: 330, h: 216 }
        ]
      },
      {
        id: 'frame03',
        name: '03',
        dataUrl: './images/03.png.png',
        baseWidth: 667,
        baseHeight: 1000,
        slots: [
          { x: 136, y: 156, w: 356, h: 216 },
          { x: 136, y: 385, w: 356, h: 215 },
          { x: 136, y: 614, w: 356, h: 177 }
        ]
      }
    ];

    const DEFAULT_AUTO_SLOTS = [
      { x: .255, y: .085, w: .49, h: .22 },
      { x: .255, y: .325, w: .49, h: .22 },
      { x: .255, y: .565, w: .49, h: .22 }
    ];

    const state = { frames: [], currentFrameId: null, photos: [], stream: null, capturing: false };

    const els = {
      startCameraBtn: document.getElementById('startCameraBtn'),
      staffModeBtn: document.getElementById('staffModeBtn'),
      staffPanel: document.getElementById('staffPanel'),
      cameraSelect: document.getElementById('cameraSelect'),
      shotModeSelect: document.getElementById('shotModeSelect'),
      videoWrap: document.getElementById('videoWrap'),
      video: document.getElementById('video'),
      countdown: document.getElementById('countdown'),
      captureBtn: document.getElementById('captureBtn'),
      clearShotsBtn: document.getElementById('clearShotsBtn'),
      photoUpload: document.getElementById('photoUpload'),
      frameUpload: document.getElementById('frameUpload'),
      resetFramesBtn: document.getElementById('resetFramesBtn'),
      framesGrid: document.getElementById('framesGrid'),
      shotList: document.getElementById('shotList'),
      status: document.getElementById('status'),
      previewCanvas: document.getElementById('previewCanvas'),
      downloadBtn: document.getElementById('downloadBtn'),
      renderBtn: document.getElementById('renderBtn'),
      handover: document.getElementById('handover'),
      showSlotGuide: document.getElementById('showSlotGuide')
    };

    function setStatus(message, type = ''){
      els.status.textContent = message;
      els.status.className = 'status' + (type ? ' ' + type : '');
    }
    function wait(ms){ return new Promise(resolve => setTimeout(resolve, ms)); }
    function fileToDataURL(file){
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }
    function loadImage(src){
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = () => reject(new Error('圖片讀取失敗：' + src));
        img.src = src;
      });
    }
    function getCurrentFrame(){ return state.frames.find(f => f.id === state.currentFrameId) || state.frames[0] || null; }
    function normalizeSlot(slot, frame){
      if ('x' in slot && slot.x > 1){
        return { x: slot.x / frame.baseWidth, y: slot.y / frame.baseHeight, w: slot.w / frame.baseWidth, h: slot.h / frame.baseHeight };
      }
      return slot;
    }
    function scaledSlot(slot, frame, bleedPx = 4){
      const n = normalizeSlot(slot, frame);
      const bx = bleedPx / EXPORT_W;
      const by = bleedPx / EXPORT_H;
      return { x: (n.x - bx) * EXPORT_W, y: (n.y - by) * EXPORT_H, w: (n.w + bx * 2) * EXPORT_W, h: (n.h + by * 2) * EXPORT_H };
    }
    function drawCover(ctx, source, dx, dy, dw, dh){
      const sw = source.videoWidth || source.naturalWidth || source.width;
      const sh = source.videoHeight || source.naturalHeight || source.height;
      if (!sw || !sh || !dw || !dh) return;
      const sourceRatio = sw / sh;
      const destRatio = dw / dh;
      let sx = 0, sy = 0, sWidth = sw, sHeight = sh;
      if (sourceRatio > destRatio){ sWidth = sh * destRatio; sx = (sw - sWidth) / 2; }
      else{ sHeight = sw / destRatio; sy = (sh - sHeight) / 2; }
      ctx.drawImage(source, sx, sy, sWidth, sHeight, dx, dy, dw, dh);
    }
    function drawPlaceholder(ctx, index, slot){
      ctx.save();
      ctx.fillStyle = '#111827';
      ctx.fillRect(slot.x, slot.y, slot.w, slot.h);
      ctx.strokeStyle = 'rgba(255,255,255,.18)';
      ctx.lineWidth = 3;
      ctx.strokeRect(slot.x, slot.y, slot.w, slot.h);
      ctx.fillStyle = 'rgba(255,255,255,.35)';
      ctx.font = '900 54px -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(String(index + 1), slot.x + slot.w / 2, slot.y + slot.h / 2);
      ctx.restore();
    }
    function drawSlotGuide(ctx, slot){
      ctx.save();
      ctx.setLineDash([12, 8]);
      ctx.strokeStyle = 'rgba(56,189,248,.9)';
      ctx.lineWidth = 4;
      ctx.strokeRect(slot.x, slot.y, slot.w, slot.h);
      ctx.restore();
    }
    function renderPreview(){
      const canvas = els.previewCanvas;
      const ctx = canvas.getContext('2d');
      canvas.width = EXPORT_W;
      canvas.height = EXPORT_H;
      const frame = getCurrentFrame();
      ctx.clearRect(0, 0, EXPORT_W, EXPORT_H);
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, EXPORT_W, EXPORT_H);
      if (!frame){
        ctx.fillStyle = '#fff';
        ctx.font = '700 42px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('尚未載入相框', EXPORT_W / 2, EXPORT_H / 2);
        els.downloadBtn.disabled = true;
        return;
      }
      const slots = frame.slots && frame.slots.length >= 3 ? frame.slots : DEFAULT_AUTO_SLOTS;
      for (let i = 0; i < PHOTO_COUNT; i++){
        const slot = scaledSlot(slots[i], frame, 5);
        if (state.photos[i]) drawCover(ctx, state.photos[i], slot.x, slot.y, slot.w, slot.h);
        else drawPlaceholder(ctx, i, slot);
      }
      ctx.drawImage(frame.img, 0, 0, EXPORT_W, EXPORT_H);
      if (els.showSlotGuide.checked){
        for (let i = 0; i < PHOTO_COUNT; i++) drawSlotGuide(ctx, scaledSlot(slots[i], frame, 0));
      }
      els.downloadBtn.disabled = state.photos.length < PHOTO_COUNT;
    }
    function renderShotList(){
      els.shotList.innerHTML = '';
      for (let i = 0; i < PHOTO_COUNT; i++){
        const cell = document.createElement('div');
        cell.className = 'shot';
        if (state.photos[i]){
          const img = document.createElement('img');
          img.src = state.photos[i].src;
          cell.appendChild(img);
        }else cell.textContent = String(i + 1);
        els.shotList.appendChild(cell);
      }
    }
    function renderFrameCards(){
      els.framesGrid.innerHTML = '';
      state.frames.forEach(frame => {
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'frameCard' + (frame.id === state.currentFrameId ? ' active' : '');
        card.innerHTML = '<img alt=""><span></span>';
        card.querySelector('img').src = frame.dataUrl;
        card.querySelector('span').textContent = frame.name;
        card.addEventListener('click', () => { state.currentFrameId = frame.id; renderFrameCards(); renderPreview(); });
        els.framesGrid.appendChild(card);
      });
    }
    async function loadPresetFrames(){
      const loaded = [];
      const failed = [];
      for (const preset of PRESET_FRAMES){
        try{
          const img = await loadImage(preset.dataUrl);
          loaded.push({ ...preset, img });
        }catch(err){
          console.warn(err);
          failed.push(preset.dataUrl);
        }
      }
      state.frames = loaded;
      state.currentFrameId = loaded[0] ? loaded[0].id : null;
      renderFrameCards();
      renderPreview();
      if (!loaded.length) setStatus('沒有成功載入相框。請確認 images 資料夾與檔名大小寫。', 'bad');
      else if (failed.length) setStatus(`已載入 ${loaded.length} 款相框；有 ${failed.length} 款讀不到：${failed.join('、')}。請確認檔名是否存在。`, 'bad');
      else setStatus(`已載入 ${loaded.length} 款相框，順序是：貓、狗、電影節、畢業、01、02、03。`, 'ok');
    }
    async function refreshCameras(){
      if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) return;
      const devices = await navigator.mediaDevices.enumerateDevices();
      const cameras = devices.filter(d => d.kind === 'videoinput');
      const current = els.cameraSelect.value;
      els.cameraSelect.innerHTML = '';
      if (!cameras.length){
        const opt = document.createElement('option'); opt.value = ''; opt.textContent = '沒有偵測到鏡頭'; els.cameraSelect.appendChild(opt); return;
      }
      cameras.forEach((camera, index) => {
        const opt = document.createElement('option');
        opt.value = camera.deviceId;
        opt.textContent = camera.label || `鏡頭 ${index + 1}`;
        els.cameraSelect.appendChild(opt);
      });
      if (current && cameras.some(c => c.deviceId === current)) els.cameraSelect.value = current;
    }
    function stopCamera(){
      if (state.stream){ state.stream.getTracks().forEach(track => track.stop()); state.stream = null; }
    }
    async function startCamera(){
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){ setStatus('這個瀏覽器不支援相機。請改用 Chrome / Safari，或直接上傳照片。', 'bad'); return; }
      stopCamera();
      const selectedId = els.cameraSelect.value;
      const videoConstraint = selectedId ? { deviceId: { exact: selectedId }, width: { ideal: 1920 }, height: { ideal: 1080 } } : { facingMode: 'user', width: { ideal: 1920 }, height: { ideal: 1080 } };
      try{
        state.stream = await navigator.mediaDevices.getUserMedia({ video: videoConstraint, audio: false });
        els.video.srcObject = state.stream;
        await els.video.play();
        await refreshCameras();
        els.captureBtn.disabled = false;
        setStatus('相機已啟動。按「開始拍 3 張」即可拍攝。', 'ok');
      }catch(err){ console.error(err); setStatus('相機啟動失敗。請確認瀏覽器權限，或改用上傳照片。', 'bad'); }
    }
    async function captureCurrentPhoto(){
      const video = els.video;
      const vw = video.videoWidth, vh = video.videoHeight;
      if (!vw || !vh) throw new Error('相機尚未準備好');
      const c = document.createElement('canvas');
      c.width = vw; c.height = vh;
      const ctx = c.getContext('2d');
      if (els.shotModeSelect.value === 'mirror'){ ctx.translate(vw, 0); ctx.scale(-1, 1); }
      ctx.drawImage(video, 0, 0, vw, vh);
      return await loadImage(c.toDataURL('image/jpeg', .95));
    }
    async function runCountdown(seconds){
      els.countdown.classList.add('show');
      for (let i = seconds; i >= 1; i--){ els.countdown.textContent = String(i); await wait(1000); }
      els.countdown.textContent = '';
      els.countdown.classList.remove('show');
    }
    async function captureThreePhotos(){
      if (state.capturing) return;
      if (!state.stream){ setStatus('請先啟動相機，或直接上傳照片。', 'bad'); return; }
      state.capturing = true; els.captureBtn.disabled = true; state.photos = []; renderShotList(); renderPreview();
      try{
        for (let i = 0; i < PHOTO_COUNT; i++){
          setStatus(`準備拍第 ${i + 1} 張，倒數 ${COUNTDOWN_SECONDS} 秒。`);
          await runCountdown(COUNTDOWN_SECONDS);
          const photo = await captureCurrentPhoto();
          state.photos.push(photo);
          renderShotList(); renderPreview();
          setStatus(`第 ${i + 1} 張完成。`, 'ok');
          if (i < PHOTO_COUNT - 1) await wait(700);
        }
        setStatus('三張都拍完了，可以下載成品。', 'ok');
        els.handover.classList.add('show');
      }catch(err){ console.error(err); setStatus('拍攝失敗，請重新啟動相機再試一次。', 'bad'); }
      finally{ state.capturing = false; els.captureBtn.disabled = !state.stream; els.countdown.classList.remove('show'); }
    }
    async function handlePhotoUpload(event){
      const files = Array.from(event.target.files || []).slice(0, PHOTO_COUNT);
      if (!files.length) return;
      try{
        const images = [];
        for (const file of files){ const dataUrl = await fileToDataURL(file); images.push(await loadImage(dataUrl)); }
        state.photos = images.slice(0, PHOTO_COUNT);
        renderShotList(); renderPreview();
        setStatus(`已載入 ${state.photos.length} 張照片。${state.photos.length < 3 ? '還可以再補照片。' : '可以下載成品。'}`, 'ok');
      }catch(err){ console.error(err); setStatus('照片讀取失敗，請換一張圖片試試。', 'bad'); }
    }
    function clearShots(){ state.photos = []; els.photoUpload.value = ''; renderShotList(); renderPreview(); setStatus('已清空照片，可以重新拍攝或重新上傳。'); }
    async function handleFrameUpload(event){
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      try{
        const dataUrl = await fileToDataURL(file);
        const img = await loadImage(dataUrl);
        const customFrame = { id: 'custom-' + Date.now(), name: file.name || '自訂相框', dataUrl, img, baseWidth: img.naturalWidth, baseHeight: img.naturalHeight, slots: DEFAULT_AUTO_SLOTS };
        state.frames.push(customFrame); state.currentFrameId = customFrame.id; renderFrameCards(); renderPreview();
        setStatus('自訂相框已載入。若位置差一點，請開啟「顯示照片窗輔助線」檢查。', 'ok');
      }catch(err){ console.error(err); setStatus('自訂相框讀取失敗。請確認是 PNG 或一般圖片格式。', 'bad'); }
    }
    function resetFrames(){
      state.frames = state.frames.filter(frame => PRESET_FRAMES.some(p => p.id === frame.id));
      state.currentFrameId = state.frames[0] ? state.frames[0].id : null;
      els.frameUpload.value = '';
      renderFrameCards(); renderPreview(); setStatus('已恢復預設相框。', 'ok');
    }
    function downloadImage(){
      renderPreview();
      if (state.photos.length < PHOTO_COUNT){ setStatus('請先拍滿或上傳 3 張照片再下載。', 'bad'); return; }
      els.previewCanvas.toBlob(blob => {
        if (!blob){ setStatus('下載失敗，請再試一次。', 'bad'); return; }
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        const now = new Date();
        const pad = n => String(n).padStart(2, '0');
        a.href = url;
        a.download = `utopia-photobooth-${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}.png`;
        document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
        setStatus('成品已下載。', 'ok');
      }, 'image/png');
    }
    function syncShotMode(){ els.videoWrap.classList.toggle('mirror', els.shotModeSelect.value === 'mirror'); }

    els.startCameraBtn.addEventListener('click', startCamera);
    els.cameraSelect.addEventListener('change', () => { if (state.stream) startCamera(); });
    els.shotModeSelect.addEventListener('change', syncShotMode);
    els.captureBtn.addEventListener('click', captureThreePhotos);
    els.clearShotsBtn.addEventListener('click', clearShots);
    els.photoUpload.addEventListener('change', handlePhotoUpload);
    els.frameUpload.addEventListener('change', handleFrameUpload);
    els.resetFramesBtn.addEventListener('click', resetFrames);
    els.renderBtn.addEventListener('click', renderPreview);
    els.downloadBtn.addEventListener('click', downloadImage);
    els.staffModeBtn.addEventListener('click', () => { els.staffPanel.classList.toggle('show'); els.staffModeBtn.textContent = els.staffPanel.classList.contains('show') ? '關閉工作人員模式' : '工作人員模式'; });
    els.handover.addEventListener('click', () => els.handover.classList.remove('show'));
    els.showSlotGuide.addEventListener('change', renderPreview);
    window.addEventListener('beforeunload', stopCamera);

    renderShotList();
    syncShotMode();
    loadPresetFrames();
  </script>
</body>
</html>
